# Atom4 relay environment example (antiX 21, Node 16, 32-bit)
# Live path: /home/atom/.relay/relay.env (mode 600)
# This file contains placeholders only. Never commit live tokens.

NODE_ID=atom4
RELAY_ROLE=relay
RELAY_HOST=0.0.0.0
RELAY_PORT=8400

# Secretary endpoint reachable from Atom4.
ATOM1_HOST=192.168.1.11
ATOM1_PORT=8080

# Inbound identity affinity: /webhook/viber/lina1 -> LINA-1 -> atom1.
RELAY_BOT_LINA1=atom1
RELAY_BOT_LINA1_NUMBER=VIBER-1

# Separate relay-to-secretary and bridge-to-relay credentials.
# These are relay credentials, not Viber account tokens.
RELAY_TOKEN_LINA1=<set-a-unique-random-secret>
RELAY_TOKEN_VIBER1=<set-a-different-unique-random-secret>

# Small-board defaults.
WORKER_INTERVAL_SECONDS=15
ATOM_DEAD_THRESHOLD=3
ATOM_DEAD_COOLDOWN_SECONDS=60
ATOM_FETCH_TIMEOUT_MS=5000
MAX_BODY_BYTES=262144
RETENTION_PROCESSED_HOURS=24
RETENTION_FAILED_DAYS=30
